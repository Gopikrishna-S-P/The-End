# Copy to .env and fill in real values. Never commit .env itself (already gitignored).

# =========================
# SERVER CONFIG
# =========================
PORT=8080

# =========================
# DATABASE CONFIG
# =========================
DB_URL=jdbc:postgresql://localhost:5432/opstool
DB_USER=opstool
DB_PASSWORD=changeme
DB_POOL_SIZE=10
DB_MIN_IDLE=2

# =========================
# FILE UPLOAD
# =========================
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB
# Local-disk storage path (no AWS/S3). On a real deployment this must be a durable,
# backed-up path on the server -- see AWS_S3_ENABLED below.
UPLOAD_DIR=/home/ubuntu/uploads

# =========================
# MAIL CONFIG
# =========================
MAIL_USERNAME=
MAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Recoverpro

# =========================
# APP CONFIG
# =========================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
APP_ENV=local
TIMEZONE=Asia/Kolkata

# =========================
# JWT CONFIG
# =========================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
JWT_EXPIRATION_MS=3600000
REFRESH_TOKEN_EXP_DAYS=30

# =========================
# PII ENCRYPTION (AES-256-GCM, required at startup)
# =========================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY_BASE64=
# Must be a DIFFERENT key from the one above -- do not reuse. If unset, LookupHashService
# falls back to deriving this key from PII_ENCRYPTION_KEY_BASE64 and logs a warning on
# every boot. Rotating this on a database with existing borrowers requires re-running
# LookupHashBackfillRunner (app.backfill.lookup-hash=true, ONE run only) to recompute
# existing phone/email/ckycId lookup hashes -- otherwise duplicate-borrower detection
# silently stops matching pre-existing rows.
PII_LOOKUP_HASH_KEY_BASE64=

# =========================
# PLATFORM ADMIN BOOTSTRAP (required only to create the account the first time)
# =========================
# Rotate immediately after first login -- this value only protects the account until
# it's changed through the app.
PLATFORM_ADMIN_BOOTSTRAP_PASSWORD=

# =========================
# GOOGLE OAUTH2 CONFIG
# =========================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH2_ENABLED=false
OAUTH2_REDIRECT_URI=

# =========================
# LOGGING CONFIG
# =========================
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_SPRING=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_HIBERNATE=INFO
LOG_LEVEL_AWS=INFO
LOG_LEVEL_SECURITY=INFO
LOG_LEVEL_OAUTH2=INFO

# =========================
# MANAGEMENT ENDPOINTS
# =========================
MANAGEMENT_PORT=9090
MANAGEMENT_ADDRESS=0.0.0.0

# =========================
# AWS S3 CONFIG (optional -- leave AWS_S3_ENABLED=false to use local-disk storage)
# =========================
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_RELEASES_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENABLED=false
AWS_SIGNED_URL_DURATION=24
UPDATE_SECRET=

# =========================
# VISIT LOG CONFIG
# =========================
VISIT_LOG_MAX_SIZE=5242880

# =========================
# DEEP LINK CONFIG
# =========================
DEEP_LINK_BASE=recoverpro://app

# =========================
# OLLAMA / LUCIEN AI
# =========================
LLAMA_MODEL=llama3.2:1b
LLAMA_READ_TIMEOUT_MS=180000

# =========================
# ONE-TIME MAINTENANCE SWITCHES (leave false; see comments above)
# =========================
LOOKUP_HASH_BACKFILL=false
