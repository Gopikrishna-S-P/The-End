# Copy to .env.local (or .env.production/.env.staging for a specific build) and fill in
# real values. Vite only exposes VITE_-prefixed vars to client code, and bakes them in at
# BUILD time -- this Dockerfile has no runtime-templating step, so each environment needs
# its own build with its own values, not a single image reconfigured at container-run time.

# Sentry DSN for browser crash/error reporting (wired in src/main.tsx + src/App.tsx's
# AppErrorBoundary + src/components/RouteErrorBoundary.tsx). Leave unset to no-op --
# useful for local dev so you don't need a Sentry account to run the app.
VITE_SENTRY_DSN=
